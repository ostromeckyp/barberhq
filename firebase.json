{
  "dataconnect": {
    "source": "dataconnect"
  },
  "emulators": {
    "dataconnect": {
      "host": "127.0.0.1",
      "port": 9399
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true,
    "hosting": {
      "host": "127.0.0.1",
      "port": 5002
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    }
  },
  "hosting": {
    "site": "notbad-6be95",
    "public": "web/dist/barberhq/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map", "**/*.pdf"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "predeploy": ["node --import tsx scripts/checks/release.ts"]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "stock",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "**/*.log"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
