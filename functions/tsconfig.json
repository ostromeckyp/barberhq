{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "lib",
    "rootDir": ".."
  },
  "include": ["src/**/*.ts", "../shared/contracts/**/*.ts"],
  "exclude": ["src/generated"]
}
