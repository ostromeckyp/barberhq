{
  "name": "barberhq-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:web": "node scripts/checks/web-test.mjs",
    "test:e2e": "playwright test",
    "prepare:data": "node --import tsx scripts/prepare-data/cli.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "node --import tsx scripts/seed/cli.ts",
    "generate:sdk": "firebase dataconnect:sdk:generate --project notbad-6be95",
    "check:hosting": "node --import tsx scripts/checks/hosting.ts",
    "configure:emulators": "node --import tsx scripts/config/build-web.ts --config config/emulator.example.json --project demo-barberhq --emulator --configure-only",
    "start:emulators": "npm --prefix functions run build && firebase emulators:start --only auth,dataconnect,functions --project demo-barberhq",
    "build:emulator": "node --import tsx scripts/config/build-web.ts --config config/emulator.example.json --project demo-barberhq --emulator",
    "build:production": "node --import tsx scripts/config/build-web.ts",
    "demo:local": "node --import tsx scripts/dev/demo.ts",
    "start:local": "npm --prefix web run start:emulator",
    "build:functions": "npm --prefix functions run build",
    "demo:reset": "node --import tsx scripts/seed/reset.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "firebase-tools": "15.32.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@barberhq/browser": "file:web/src/app/core/generated",
    "@barberhq/browser-admin": "file:scripts/generated/browser",
    "@barberhq/server": "file:scripts/generated/server",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "zod": "4.6.5"
  }
}
